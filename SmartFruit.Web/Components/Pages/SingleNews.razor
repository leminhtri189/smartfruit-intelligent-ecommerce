@page "/single-news/{id:int}"
@using System.ComponentModel.DataAnnotations

<PageTitle>@article?.Title - SmartFruit News</PageTitle>

<!-- breadcrumb-section -->
<div class="breadcrumb-section breadcrumb-bg">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 offset-lg-2 text-center">
				<div class="breadcrumb-text">
					<p>Read the Details</p>
					<h1>Single Article</h1>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end breadcrumb section -->

<!-- single article section -->
<div class="mt-150 mb-150">
	<div class="container">
		<div class="row">
			<div class="col-lg-8">
				<div class="single-article-section">
					@if (article != null)
					{
						<div class="single-article-text">
							<div class="single-artcile-bg" style="background-image: url('@article.ImageUrl');"></div>
							<p class="blog-meta">
								<span class="author"><i class="fas fa-user"></i> @article.Author</span>
								<span class="date"><i class="fas fa-calendar"></i> @article.PublishDate.ToString("dd MMMM, yyyy")</span>
							</p>
							<h2>@article.Title</h2>
							@foreach (var paragraph in article.Content.Split('\n'))
							{
								<p>@paragraph</p>
							}
						</div>

						<div class="comments-list-wrap">
							<h3 class="comment-count-title">@comments.Count Comments</h3>
							<div class="comment-list">
								@foreach (var comment in comments)
								{
									<div class="single-comment-body @(comment.IsReply ? "child" : "")">
										<div class="comment-user-avater">
											<img src="@comment.AvatarUrl" alt="@comment.AuthorName">
										</div>
										<div class="comment-text-body">
											<h4>@comment.AuthorName <span class="comment-date">@comment.CommentDate.ToString("MMM dd, yyyy")</span> <a href="#" @onclick="() => ReplyToComment(comment.Id)">reply</a></h4>
											<p>@comment.Content</p>
										</div>
									</div>
								}
							</div>
						</div>

						<div class="comment-template">
							<h4>Leave a comment</h4>
							<p>If you have a comment don't feel hesitate to send us your opinion.</p>
							<EditForm Model="@commentForm" OnValidSubmit="@SubmitComment">
								<DataAnnotationsValidator />
								<ValidationSummary />
								<p>
									<InputText @bind-Value="commentForm.Name" placeholder="Your Name" class="form-control" />
									<InputText @bind-Value="commentForm.Email" placeholder="Your Email" class="form-control" />
								</p>
								<p><InputTextArea @bind-Value="commentForm.Message" placeholder="Your Message" rows="10" class="form-control" /></p>
								<p><button type="submit" class="btn btn-primary">Submit</button></p>
							</EditForm>
						</div>
					}
					else
					{
						<div class="text-center">
							<h3>Article not found</h3>
							<NavLink href="/news" class="boxed-btn">Back to News</NavLink>
						</div>
					}
				</div>
			</div>
			<div class="col-lg-4">
				<div class="sidebar-section">
					<div class="recent-posts">
						<h4>Recent Posts</h4>
						<ul>
							@foreach (var recentPost in recentPosts)
							{
								<li><NavLink href="@($"/single-news/{recentPost.Id}")">@recentPost.Title</NavLink></li>
							}
						</ul>
					</div>
					<div class="archive-posts">
						<h4>Archive Posts</h4>
						<ul>
							<li><a href="#">JAN 2024 (5)</a></li>
							<li><a href="#">FEB 2024 (3)</a></li>
							<li><a href="#">MAR 2024 (8)</a></li>
							<li><a href="#">APR 2024 (6)</a></li>
							<li><a href="#">MAY 2024 (4)</a></li>
						</ul>
					</div>
					<div class="tag-section">
						<h4>Tags</h4>
						<ul>
							<li><a href="#">Organic</a></li>
							<li><a href="#">Fresh</a></li>
							<li><a href="#">Health</a></li>
							<li><a href="#">Nutrition</a></li>
							<li><a href="#">Fruits</a></li>
							<li><a href="#">Technology</a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end single article section -->

<!-- logo carousel -->
<div class="logo-carousel-section">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="logo-carousel-inner">
					<div class="single-logo-item">
						<img src="assets/img/company-logos/1.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="assets/img/company-logos/2.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="assets/img/company-logos/3.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="assets/img/company-logos/4.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="assets/img/company-logos/5.png" alt="">
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end logo carousel -->

@code {
	[Parameter] public int Id { get; set; }

	private Article? article;
	private List<Comment> comments = new();
	private List<Article> recentPosts = new();
	private CommentForm commentForm = new();

	protected override void OnInitialized()
	{
		LoadArticle();
		LoadComments();
		LoadRecentPosts();
	}

	private void LoadArticle()
	{
		var articles = new List<Article>
		{
			new Article 
			{ 
				Id = 1, 
				Title = "SmartFruit Technology Revolutionizes Fruit Quality Detection", 
				Author = "Admin", 
				PublishDate = new DateTime(2024, 1, 15),
				ImageUrl = "assets/img/latest-news/news-bg-1.jpg",
				Content = "Our innovative AI-powered quality detection system is transforming how we ensure fruit freshness and quality. Using advanced computer vision and machine learning algorithms, we can now detect ripeness, defects, and optimal harvest times with unprecedented accuracy.\n\nThis technology not only improves the quality of fruits that reach consumers but also reduces waste throughout the supply chain. By identifying the perfect moment for harvest and delivery, we're able to maximize both nutritional value and taste.\n\nThe system analyzes multiple factors including color, texture, size, and even subtle chemical markers that indicate ripeness. This comprehensive approach ensures that every piece of fruit meets our high standards before it reaches your table."
			},
			new Article 
			{ 
				Id = 2, 
				Title = "Sustainable Farming Practices for Better Future", 
				Author = "Admin", 
				PublishDate = new DateTime(2024, 1, 12),
				ImageUrl = "assets/img/latest-news/news-bg-2.jpg",
				Content = "Sustainability is at the heart of everything we do at SmartFruit. Our partner farms are implementing cutting-edge eco-friendly practices that not only protect the environment but also produce superior quality fruits.\n\nFrom water-efficient irrigation systems to natural pest control methods, we're proving that sustainable farming can be both environmentally responsible and economically viable. Our farmers use precision agriculture techniques to minimize resource usage while maximizing yield quality.\n\nThese practices include crop rotation, companion planting, and the use of beneficial insects for natural pest control. The result is healthier soil, cleaner water, and fruits that are not only delicious but also free from harmful chemicals."
			}
		};

		article = articles.FirstOrDefault(a => a.Id == Id);
	}

	private void LoadComments()
	{
		comments = new List<Comment>
		{
			new Comment 
			{ 
				Id = 1, 
				AuthorName = "Jenny Joe", 
				Content = "This is amazing! I love how SmartFruit is using technology to improve fruit quality. Can't wait to try the new detection system.",
				CommentDate = new DateTime(2024, 1, 20),
				AvatarUrl = "assets/img/avaters/avatar1.png"
			},
			new Comment 
			{ 
				Id = 2, 
				AuthorName = "Simon Soe", 
				Content = "Great article! The sustainability aspect is particularly impressive. It's good to see companies taking environmental responsibility seriously.",
				CommentDate = new DateTime(2024, 1, 21),
				AvatarUrl = "assets/img/avaters/avatar3.png",
				IsReply = true
			},
			new Comment 
			{ 
				Id = 3, 
				AuthorName = "Addy Aoe", 
				Content = "I've been following SmartFruit's progress and I'm consistently impressed by their innovation. Keep up the great work!",
				CommentDate = new DateTime(2024, 1, 22),
				AvatarUrl = "assets/img/avaters/avatar2.png"
			}
		};
	}

	private void LoadRecentPosts()
	{
		recentPosts = new List<Article>
		{
			new Article { Id = 3, Title = "Health Benefits of Organic Fruits" },
			new Article { Id = 4, Title = "Fall in Love with Fresh Seasonal Oranges" },
			new Article { Id = 5, Title = "Why Berries Are Nature's Superfood" },
			new Article { Id = 6, Title = "SmartFruit Expands Delivery Network" }
		};
	}

	private void ReplyToComment(int commentId)
	{
		// Handle reply functionality
	}

	private async Task SubmitComment()
	{
		// Handle comment submission
		var newComment = new Comment
		{
			Id = comments.Count + 1,
			AuthorName = commentForm.Name,
			Content = commentForm.Message,
			CommentDate = DateTime.Now,
			AvatarUrl = "assets/img/avaters/avatar1.png"
		};

		comments.Add(newComment);
		commentForm = new CommentForm();
		StateHasChanged();

		await Task.CompletedTask;
	}

	public class Article
	{
		public int Id { get; set; }
		public string Title { get; set; } = "";
		public string Author { get; set; } = "";
		public DateTime PublishDate { get; set; }
		public string ImageUrl { get; set; } = "";
		public string Content { get; set; } = "";
	}

	public class Comment
	{
		public int Id { get; set; }
		public string AuthorName { get; set; } = "";
		public string Content { get; set; } = "";
		public DateTime CommentDate { get; set; }
		public string AvatarUrl { get; set; } = "";
		public bool IsReply { get; set; }
	}

	public class CommentForm
	{
		[Required]
		public string Name { get; set; } = "";
		
		[Required]
		[EmailAddress]
		public string Email { get; set; } = "";
		
		[Required]
		public string Message { get; set; } = "";
	}
}
