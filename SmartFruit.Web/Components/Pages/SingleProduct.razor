@page "/single-product/{id:int}"

<PageTitle>@product?.Name - SmartFruit</PageTitle>

<!-- breadcrumb-section -->
<div class="breadcrumb-section breadcrumb-bg">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 offset-lg-2 text-center">
				<div class="breadcrumb-text">
					<p>See more Details</p>
					<h1>Single Product</h1>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end breadcrumb section -->

<!-- single product -->
<div class="single-product mt-150 mb-150">
	<div class="container">
		@if (product != null)
		{
			<div class="row">
				<div class="col-md-5">
					<div class="single-product-img">
						<img src="@product.ImageUrl" alt="@product.Name">
					</div>
				</div>
				<div class="col-md-7">
					<div class="single-product-content">
						<h3>@product.Name</h3>
						<p class="single-product-pricing"><span>Per Kg</span> $@product.Price</p>
						<p>@product.Description</p>
						<div class="single-product-form">
							<EditForm Model="@orderForm" OnValidSubmit="@AddToCart">
								<InputNumber @bind-Value="orderForm.Quantity" placeholder="0" min="1" />
								<button type="submit" class="cart-btn"><i class="fas fa-shopping-cart"></i> Add to Cart</button>
							</EditForm>
							<p><strong>Categories: </strong>@string.Join(", ", product.Categories)</p>
						</div>
						<h4>Share:</h4>
						<ul class="product-share">
							<li><a href="#"><i class="fab fa-facebook-f"></i></a></li>
							<li><a href="#"><i class="fab fa-twitter"></i></a></li>
							<li><a href="#"><i class="fab fa-google-plus-g"></i></a></li>
							<li><a href="#"><i class="fab fa-linkedin"></i></a></li>
						</ul>
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="row">
				<div class="col-12 text-center">
					<h3>Product not found</h3>
					<NavLink href="/shop" class="boxed-btn">Back to Shop</NavLink>
				</div>
			</div>
		}
	</div>
</div>
<!-- end single product -->

<!-- more products -->
<div class="more-products mb-150">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 offset-lg-2 text-center">
				<div class="section-title">	
					<h3><span class="orange-text">Related</span> Products</h3>
					<p>Discover more fresh and organic fruits from our collection.</p>
				</div>
			</div>
		</div>
		<div class="row">
			@foreach (var relatedProduct in relatedProducts)
			{
				<div class="col-lg-4 col-md-6 text-center">
					<div class="single-product-item">
						<div class="product-image">
							<NavLink href="@($"/single-product/{relatedProduct.Id}")"><img src="@relatedProduct.ImageUrl" alt="@relatedProduct.Name"></NavLink>
						</div>
						<h3>@relatedProduct.Name</h3>
						<p class="product-price"><span>Per Kg</span> $@relatedProduct.Price </p>
						<NavLink href="/cart" class="cart-btn"><i class="fas fa-shopping-cart"></i> Add to Cart</NavLink>
					</div>
				</div>
			}
		</div>
	</div>
</div>
<!-- end more products -->

<!-- logo carousel -->
<div class="logo-carousel-section">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="logo-carousel-inner">
					<div class="single-logo-item">
						<img src="assets/img/company-logos/1.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="assets/img/company-logos/2.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="assets/img/company-logos/3.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="assets/img/company-logos/4.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="assets/img/company-logos/5.png" alt="">
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end logo carousel -->

@code {
	[Parameter] public int Id { get; set; }

	private Product? product;
	private List<Product> relatedProducts = new();
	private OrderForm orderForm = new();

	protected override void OnInitialized()
	{
		LoadProduct();
		LoadRelatedProducts();
	}

	private void LoadProduct()
	{
		// Sample products data
		var products = new List<Product>
		{
			new Product { Id = 1, Name = "Fresh Strawberry", Price = 85, ImageUrl = "assets/img/products/product-img-1.jpg", Description = "Fresh, juicy strawberries packed with vitamins and antioxidants. Perfect for snacking or adding to your favorite recipes.", Categories = new[] { "Fruits", "Organic", "Berries" } },
			new Product { Id = 2, Name = "Mixed Berry", Price = 70, ImageUrl = "assets/img/products/product-img-2.jpg", Description = "A delicious mix of fresh berries including blueberries, raspberries, and blackberries.", Categories = new[] { "Fruits", "Organic", "Berries" } },
			new Product { Id = 3, Name = "Fresh Lemon", Price = 35, ImageUrl = "assets/img/products/product-img-3.jpg", Description = "Bright, zesty lemons perfect for cooking, baking, or making fresh lemonade.", Categories = new[] { "Fruits", "Citrus" } },
			new Product { Id = 4, Name = "Ripe Avocado", Price = 50, ImageUrl = "assets/img/products/product-img-4.jpg", Description = "Creamy, nutrient-rich avocados perfect for salads, toast, or guacamole.", Categories = new[] { "Fruits", "Organic" } },
			new Product { Id = 5, Name = "Green Apple", Price = 45, ImageUrl = "assets/img/products/product-img-5.jpg", Description = "Crisp green apples with polyphenols and natural sweetness. Great for snacking or baking.", Categories = new[] { "Fruits", "Organic", "Apples" } }
		};

		product = products.FirstOrDefault(p => p.Id == Id);
	}

	private void LoadRelatedProducts()
	{
		// Load 3 random related products (excluding current product)
		var allProducts = new List<Product>
		{
			new Product { Id = 1, Name = "Strawberry", Price = 85, ImageUrl = "assets/img/products/product-img-1.jpg" },
			new Product { Id = 2, Name = "Berry", Price = 70, ImageUrl = "assets/img/products/product-img-2.jpg" },
			new Product { Id = 3, Name = "Lemon", Price = 35, ImageUrl = "assets/img/products/product-img-3.jpg" }
		};

		relatedProducts = allProducts.Where(p => p.Id != Id).Take(3).ToList();
	}

	private async Task AddToCart()
	{
		// Add to cart logic
		await Task.CompletedTask;
		// Reset form
		orderForm = new OrderForm();
	}

	public class Product
	{
		public int Id { get; set; }
		public string Name { get; set; } = "";
		public decimal Price { get; set; }
		public string ImageUrl { get; set; } = "";
		public string Description { get; set; } = "";
		public string[] Categories { get; set; } = new string[0];
	}

	public class OrderForm
	{
		public int Quantity { get; set; } = 1;
	}
}
