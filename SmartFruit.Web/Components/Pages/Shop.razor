						<NavLink href="/single-product/1"><img src="assets/img/products/product-img-1.jpg" alt=""></NavLink>
					</div>
					<h3>Strawberry</h3>
					<p class="product-price"><span>Per Kg</span> $85 </p>
					<NavLink href="/cart" class="cart-btn"><i class="fas fa-shopping-cart"></i> Add to Cart</NavLink>
